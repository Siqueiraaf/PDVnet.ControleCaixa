<Window x:Class="OrdeP.ControleCaixa.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrdeP.ControleCaixa.UI"
        xmlns:vm="clr-namespace:OrdeP.ControleCaixa.UI.ViewModels"
        xmlns:view="clr-namespace:OrdeP.ControleCaixa.UI.Views.Movimentacao"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Controle de Caixa" Height="800" Width="1200">

    <Grid Margin="20">

        <Border BorderBrush="Gray"
                BorderThickness="1"
                Background="White"
                CornerRadius="20"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="260"
                            Height="70"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Left">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="SALDO TOTAL EM CAIXA"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Lista.SaldoTotal, StringFormat=R$ {0:N2}}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Width="260"
                            Height="70"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Right">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="MOVIMENTAÇÃO TOTAL"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Lista.TotalMovimentacoes}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>
                    </Border>

                </Grid>

                <TextBlock Grid.Row="1"
                           Foreground="DarkOrange"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Text="{Binding Lista.MensagemSaldoBaixo}"
                           Visibility="{Binding Lista.SaldoBaixo,
                                Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <Grid Grid.Row="2"
                      Margin="0,10,0,10"
                      HorizontalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="FILTROS:"
                               FontWeight="Bold"
                               Margin="0,30,15,0"/>

                    <StackPanel Grid.Column="1"
                                Margin="5">

                        <TextBlock Text="Categoria"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <ComboBox Width="150"
                                  Margin="0,5,0,0"
                                  ItemsSource="{Binding Lista.Categorias}"
                                  Style="{StaticResource ComboBox3D}"
                                  SelectedItem="{Binding Lista.CategoriaSelecionada}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="5">

                        <TextBlock Text="Tipo"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <ComboBox Width="150"
                                  Margin="0,5,0,0"
                                  Style="{StaticResource ComboBox3D}"
                                  ItemsSource="{Binding Lista.TiposFiltro}"
                                  SelectedItem="{Binding Lista.TipoSelecionado}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Margin="5">

                        <TextBlock Text="Período"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <ComboBox Width="150"
                                  Margin="0,5,0,0"
                                  ItemsSource="{Binding Lista.PeriodosFiltro}"
                                  Style="{StaticResource ComboBox3D}"
                                  SelectedItem="{Binding Lista.PeriodoSelecionado}"/>

                    </StackPanel>

                    <Button Grid.Column="4"
                            Width="85"
                            Height="30"
                            Margin="0,20,5,0"
                            Content="⌕ Filtrar"
                            Style="{StaticResource Button3D}"
                            Command="{Binding Lista.FiltrarMovimentacoesCommand}"/>

                    <Button Grid.Column="5"
                            Width="85"
                            Height="30"
                            Margin="0,20,25,0"
                            Content="🧹 Limpar"
                            Style="{StaticResource Button3D}"
                            Command="{Binding Lista.LimparFiltrosCommand}"/>
                </Grid>

                <view:MovimentacaoList Grid.Row="4" DataContext="{Binding Lista}"/>

                <Grid Grid.Row="6" Margin="0,10,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">

                        <Button Width="120"
                                Height="35"
                                Margin="0,0,10,0"
                                Style="{StaticResource Button3D}"
                                Content="➕ Cadastrar"
                                Command="{Binding CadastrarCommand}"/>

                        <Button Width="120"
                                Height="35"
                                Margin="0,0,10,0"
                                Style="{StaticResource Button3D}"
                                Content="✍︎ Editar"
                                Command="{Binding EditarCommand}"/>

                        <Button Width="120"
                                Height="35"
                                Style="{StaticResource Button3D}"
                                Content="🗑 Excluir"
                                Command="{Binding ExcluirCommand}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="🔔 Saldo Baixo:"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <Slider Width="120"
                                Minimum="0"
                                Maximum="10000"
                                TickFrequency="100"
                                IsSnapToTickEnabled="True"
                                SmallChange="100"
                                LargeChange="500"
                                Value="{Binding Lista.SaldoMinimo, Mode=TwoWay}" />

                        <TextBlock Margin="8,0,0,0"
                                   Width="70"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Language="pt-BR"
                                   Text="{Binding Lista.SaldoMinimo,
                                        StringFormat=R$ {0:N2}}"/>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
    </Grid>

</Window>