<Window x:Class="OrdeP.ControleCaixa.UI.Views.MovimentacaoDelete"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Excluir Movimentação"
        Height="480"
        Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🗑 Excluir Movimentação"
                   FontSize="24"
                   FontWeight="Bold"/>

        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">

                    <TextBlock Text="Descrição"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>

                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            Background="#F8F8F8"
                            Padding="10"
                            MinHeight="70">

                        <TextBlock Text="{Binding Descricao}"
                                   TextWrapping="Wrap"/>

                    </Border>

                </StackPanel>

                <Grid Grid.Row="2"
      HorizontalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Categoria:"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding Categoria}"
                               Margin="15,0,0,0"/>


                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Tipo:"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="{Binding Tipo}"
                               Margin="15,0,0,0"/>


                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Valor:"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="{Binding Valor,
                                              StringFormat={}{0:C2},
                                              ConverterCulture=pt-BR}"
                               Margin="15,0,0,0"
                               FontWeight="Bold"/>
                </Grid>

                <Border Grid.Row="4"
                        Margin="0,0,0,5"
                        Background="#FFF3CD"
                        BorderBrush="#F0D36B"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">

                    <TextBlock
                        Text="⚠ Esta ação não poderá ser desfeita."
                        FontWeight="Bold"
                        Foreground="#8A6D3B"/>

                </Border>

            </Grid>

        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Width="110"
                    Height="35"
                    Margin="0,0,10,0"
                    Content="❌ Cancelar"
                    Style="{StaticResource Button3D}"
                    Command="{Binding CancelarCommand}"/>

            <Button Width="110"
                    Height="35"
                    Content="🗑 Excluir"
                    Style="{StaticResource Button3D}"
                    Command="{Binding ExcluirCommand}"/>

        </StackPanel>

    </Grid>

</Window>