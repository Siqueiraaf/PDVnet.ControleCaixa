<Window x:Class="PDVnet.ControleCaixa.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI"
        xmlns:vm="clr-namespace:PDVnet.ControleCaixa.UI.ViewModels"
        xmlns:view="clr-namespace:PDVnet.ControleCaixa.UI.Views.Movimentacao"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Controle de Caixa" Height="800" Width="1200">

    <Grid Margin="20">

        <Border BorderBrush="Gray"
                BorderThickness="1"
                Background="White"
                CornerRadius="20"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cards -->
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="260"
                            Height="70"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Left">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="SALDO TOTAL EM CAIXA"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding SaldoTotal, StringFormat=R$ {0:N2}}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                    <Border Grid.Column="1"
                            Width="260"
                            Height="70"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Right">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="MOVIMENTAÇÃO TOTAL"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding TotalMovimentacoes}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- Lista -->
                <view:MovimentacaoList Grid.Row="2"
                       DataContext="{Binding Lista}"/>
                
                <!-- Botões -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal">

                    <Button Width="120"
                            Height="35"
                            Margin="0,0,10,0"
                            Content="Cadastrar"
                            Command="{Binding CadastrarCommand}"/>

                    <Button Width="120"
                            Height="35"
                            Margin="0,0,10,0"
                            Content="Editar"
                            Command="{Binding EditarCommand}"/>

                    <Button Width="120"
                            Height="35"
                            Content="Excluir"
                            Command="{Binding ExcluirCommand}"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>