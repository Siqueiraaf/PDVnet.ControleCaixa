<Window x:Class="PDVnet.ControleCaixa.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI"
        xmlns:vm="clr-namespace:PDVnet.ControleCaixa.UI.ViewModels"
        xmlns:view="clr-namespace:PDVnet.ControleCaixa.UI.Views.Movimentacao"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Controle de Caixa" Height="800" Width="1200">
        

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">

        <Border BorderBrush="Gray"
                BorderThickness="1"
                Background="White"
                CornerRadius="20"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="260"
                            Height="70"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Left">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="SALDO TOTAL EM CAIXA"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Lista.SaldoTotal, StringFormat=R$ {0:N2}}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Width="260"
                            Height="70"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Right">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="MOVIMENTAÇÃO TOTAL"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Lista.TotalMovimentacoes}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>
                    </Border>

                </Grid>

                <TextBlock Grid.Row="1"
                           Text="⚠ Atenção: Saldo do caixa abaixo do mínimo permitido (R$ 100,00)."
                           Foreground="Red"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Visibility="{Binding Lista.SaldoBaixo,
                                Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Grid Grid.Row="2"
      Margin="0,10,0,10"
      HorizontalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="FILTROS:"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <StackPanel Grid.Column="1"
                                Margin="5">

                        <TextBlock Text="Categoria"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"/>

                        <ComboBox Width="150"
                                  Margin="0,5,0,0"
                                  ItemsSource="{Binding Lista.Categorias}"
                                  SelectedItem="{Binding Lista.CategoriaSelecionada}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="5">

                        <TextBlock Text="Tipo"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <ComboBox Width="150"
                                  Margin="0,5,0,0"
                                  ItemsSource="{Binding Lista.TiposFiltro}"
                                  SelectedItem="{Binding Lista.TipoSelecionado}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Margin="5">

                        <TextBlock Text="Período"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <ComboBox Width="150"
                                  Margin="0,5,0,0"
                                  ItemsSource="{Binding Lista.PeriodosFiltro}"
                                  SelectedItem="{Binding Lista.PeriodoSelecionado}"/>

                    </StackPanel>

                    <Button Grid.Column="4"
                            Width="90"
                            Height="30"
                            Margin="10,15,5,0"
                            Content="Filtrar"
                            Command="{Binding Lista.FiltrarMovimentacoesCommand}"/>

                    <Button Grid.Column="5"
                            Width="90"
                            Height="30"
                            Margin="5,15,0,0"
                            Content="Limpar filtros"
                            Command="{Binding Lista.LimparFiltrosCommand}"/>
                </Grid>

                <view:MovimentacaoList Grid.Row="4" DataContext="{Binding Lista}"/>

                <StackPanel Grid.Row="6"
                            Orientation="Horizontal">

                    <Button Width="120"
                            Height="35"
                            Margin="0,0,10,0"
                            Content="Cadastrar"
                            Command="{Binding CadastrarCommand}"/>

                    <Button Width="120"
                            Height="35"
                            Margin="0,0,10,0"
                            Content="Editar"
                            Command="{Binding EditarCommand}"/>

                    <Button Width="120"
                            Height="35"
                            Content="Excluir"
                            Command="{Binding ExcluirCommand}"/>

                </StackPanel>

            </Grid>
        </Border>
    </Grid>

</Window>