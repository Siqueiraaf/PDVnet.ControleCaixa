<Window x:Class="PDVnet.ControleCaixa.UI.Views.MovimentacaoCreate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Adicionar" Height="450" Width="500">
    
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="📝 Adicionar"
               FontSize="24"
               FontWeight="Bold"/>


        <Border Grid.Row="2"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20">


            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>



                <!-- Descrição -->

                <StackPanel Grid.Row="0"
                        Grid.ColumnSpan="2">

                    <TextBlock Text="Descrição"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                    <TextBox Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Descricao,
                             UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200"/>

                </StackPanel>



                <!-- Categoria -->
                <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Categoria:"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>


                <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      Width="200"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding Categorias}"
                      SelectedItem="{Binding Categoria}"/>

                <!-- Tipo -->
                <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Text="Tipo:"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>


                <StackPanel Grid.Row="4"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="-30,0,0,0">


                    <RadioButton Content="Entrada"
                             Margin="0,0,20,0"
                             GroupName="Tipo"
                             IsChecked="{Binding IsEntrada}"/>


                    <RadioButton Content="Saída"
                             GroupName="Tipo"
                             IsChecked="{Binding IsSaida}"/>


                </StackPanel>

                <!-- Valor -->
                <TextBlock Grid.Row="6"
                       Grid.Column="0"
                       Text="Valor:"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Width="150"
                         HorizontalAlignment="Left"
                         Margin="-20,0,0,0"
                         PreviewTextInput="NumberValidationTextBox"
                         Text="{Binding Valor,
                            UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Status -->
                <TextBlock Grid.Row="8"
                       Grid.Column="0"
                       Text="Status:"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>


                <StackPanel Grid.Row="8"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="10,0,0,0">


                    <RadioButton Content="Ativo"
                             Margin="-29,0,20,0"
                             GroupName="Status"
                             IsChecked="{Binding IsTrue}"/>


                    <RadioButton Content="Inativo"
                             GroupName="Status"
                             IsChecked="{Binding IsFalse}"/>


                </StackPanel>


            </Grid>

        </Border>



        <!-- Botões -->

        <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right">


            <Button Width="110"
                Height="25"
                Margin="0,0,10,0"
                Content="Cancelar"
                Command="{Binding CancelarMovimentacaoCommand}"/>


            <Button Width="110"
                Height="25"
                Content="Cadastrar"
                Command="{Binding CadastrarMovimentacaoCommand}"/>


        </StackPanel>


    </Grid>
</Window>
