<Window x:Class="PDVnet.ControleCaixa.UI.Views.MovimentacaoDelete"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Excluir Movimentação"
        Height="460"
        Width="430"
        WindowStartupLocation="CenterScreen">


    <Grid Margin="15">


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">


            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">


                <TextBlock Text="🗑"
                           FontSize="28"
                           Margin="0,0,8,0"/>

                <TextBlock Text="Excluir Movimentação"
                           FontSize="25"
                           FontWeight="Bold"/>

            </StackPanel>

            <TextBlock Text="Confirme os dados antes de continuar"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Foreground="Black"
                       FontSize="14"/>
        </StackPanel>

        <Border Grid.Row="2"
                Width="380"
                Background="#F7F7F7"
                CornerRadius="15"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="20"
                HorizontalAlignment="Center">

            <StackPanel>
                <Border Background="#FFEBEE"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,0,15">

                    <TextBlock Text="⚠ Atenção! Esta ação não poderá ser desfeita."
                               Foreground="#B71C1C"
                               FontWeight="Bold"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <StackPanel HorizontalAlignment="Center">


                    <TextBlock Text="Descrição:"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>


                    <Border Background="White"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Padding="10"
                            Width="320"
                            MinHeight="60">

                        <TextBlock Text="{Binding Descricao}"
                                   TextWrapping="Wrap"
                                   FontSize="13"/>

                    </Border>

                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Categoria:"
                                   FontWeight="Bold"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding Categoria}"
                                   Margin="10,0,0,0"/>

                        <TextBlock Grid.Row="2"
                                   Text="Tipo:"
                                   FontWeight="Bold"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding Tipo}"
                                   Margin="10,0,0,0"/>

                        <TextBlock Grid.Row="4"
                                   Text="Valor:"
                                   FontWeight="Bold"/>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Text="{Binding Valor, StringFormat={}{0:C},ConverterCulture=pt-BR}"
                                   Margin="10,0,0,0"
                                   FontWeight="Bold"/>

                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="Cancelar"
                    Width="110"
                    Height="32"
                    Margin="0,0,12,0"
                    Style="{StaticResource Button3D}"
                    Command="{Binding CancelarCommand}"/>

            <Button Content="Excluir"
                    Width="110"
                    Height="32"
                    Style="{StaticResource Button3D}"
                    Command="{Binding ExcluirCommand}"/>
        </StackPanel>
    </Grid>
</Window>