<UserControl x:Class="PDVnet.ControleCaixa.UI.Views.Movimentacao.MovimentacaoList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converter="clr-namespace:PDVnet.ControleCaixa.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid>

        <Border HorizontalAlignment="Center"
                MaxWidth="1400"
                Margin="0,10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid
                    x:Name="ListaMovimentacoes"
                    Grid.Row="0"
                    ItemsSource="{Binding Movimentacoes}"
                    SelectedItem="{Binding MovimentacaoSelecionada, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    HorizontalAlignment="Stretch">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Descrição" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Descricao}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Tipo}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Categoria"
                                            Binding="{Binding Categoria}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Valor"
                                            Binding="{Binding Valor, StringFormat={}{0:C}, ConverterCulture=pt-BR}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status, Converter={StaticResource StatusConverter}}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Data"
                                            Binding="{Binding DataMovimento, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                                            Width="170"/>

                    </DataGrid.Columns>

                </DataGrid>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="15">

                    <Button Width="110"
                            Height="32"
                            Margin="5"
                            Content="◀ Anterior"
                            Style="{StaticResource Button3D}"
                            Command="{Binding PaginaAnteriorCommand}" />

                    <TextBlock VerticalAlignment="Center"
                               Margin="20,0"
                               FontWeight="Bold"
                               FontSize="14">

                        <Run Text="Página "/>
                        <Run Text="{Binding PaginaAtual}"/>
                        <Run Text=" de "/>
                        <Run Text="{Binding TotalPaginas}"/>

                    </TextBlock>

                    <Button Width="110"
                            Height="32"
                            Margin="5"
                            Content="Próxima ▶"
                            Style="{StaticResource Button3D}"
                            Command="{Binding ProximaPaginaCommand}" />

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>