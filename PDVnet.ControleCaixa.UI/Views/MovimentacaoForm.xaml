<UserControl x:Class="PDVnet.ControleCaixa.UI.Components.MovimentacaoForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.ColumnSpan="2">

                    <TextBlock Text="Descrição"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>

                    <TextBox Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="200"
                             PreviewTextInput="DescriptionValidationTextBox"
                             Text="{Binding Descricao,
                                UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Categoria:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,15,0"/>

                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          Width="180"
                          HorizontalAlignment="Left"
                          Style="{StaticResource ComboBox3D}"
                          ItemsSource="{Binding Categorias}"
                          SelectedItem="{Binding Categoria}"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Tipo:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,15,0"/>


                <StackPanel Grid.Row="4"
                            Grid.Column="1"
                            Orientation="Horizontal">


                    <RadioButton Content="Entrada"
                                 Margin="0,0,25,0"
                                 GroupName="Tipo"
                                 IsChecked="{Binding IsEntrada}"/>


                    <RadioButton Content="Saída"
                             GroupName="Tipo"
                             IsChecked="{Binding IsSaida}"/>

                </StackPanel>

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Valor:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,15,0"/>

                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Width="180"
                         HorizontalAlignment="Left"
                         PreviewTextInput="NumberValidationTextBox"
                         Text="{Binding Valor,
                         UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="Status:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,15,0"
                           Visibility="{Binding ExibirStatus,
                                RelativeSource={RelativeSource AncestorType=UserControl},
                                Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <StackPanel Grid.Row="8"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding ExibirStatus,
                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                 Converter={StaticResource BooleanToVisibilityConverter}}">

                    <RadioButton Content="Ativo"
                                 Margin="0,0,25,0"
                                 GroupName="Status"
                                 IsChecked="{Binding IsTrue}"/>

                    <RadioButton Content="Inativo"
                                 GroupName="Status"
                                 IsChecked="{Binding IsFalse}"/>
                </StackPanel>

            </Grid>

        </Border>
    </Grid>
</UserControl>
